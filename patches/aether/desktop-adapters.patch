+++ b/aether/src/listeners.rs
@@ -0,0 +1,89 @@
+//! CLI listener ownership spans provisioning, scanning and every reconnect.
+//! Task-local ownership keeps independent embedded sessions isolated.
+use crate::error::Result;
+use std::{future::Future, net::SocketAddr};
+use tokio::net::TcpListener;
+
+struct Held {
+    sockets: Vec<(&'static str, SocketAddr, std::net::TcpListener)>,
+}
+
+tokio::task_local! { static HELD: Held; }
+
+pub(crate) async fn scope<T>(
+    socks: TcpListener,
+    requested: SocketAddr,
+    http: Option<TcpListener>,
+    http_requested: Option<SocketAddr>,
+    future: impl Future<Output = T>,
+) -> Result<T> {
+    let mut sockets = vec![("socks5", requested, socks.into_std()?)];
+    if let Some(http) = http {
+        sockets.push((
+            "http proxy",
+            http_requested.unwrap_or(http.local_addr()?),
+            http.into_std()?,
+        ));
+    }
+    Ok(HELD.scope(Held { sockets }, future).await)
+}
+
+/// Each tunnel gets a duplicate of the held socket. Closing that duplicate
+/// cannot release the port while the CLI run is still alive.
+pub(crate) fn duplicate(kind: &str, requested: SocketAddr) -> Option<Result<TcpListener>> {
+    HELD.try_with(|held| {
+        held.sockets
+            .iter()
+            .find(|(name, original, socket)| {
+                *name == kind
+                    && (*original == requested || socket.local_addr().ok() == Some(requested))
+            })
+            .map(|(_, _, socket)| {
+                socket
+                    .try_clone()
+                    .and_then(TcpListener::from_std)
+                    .map_err(Into::into)
+            })
+    })
+    .ok()
+    .flatten()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    async fn socks_and_http_ports_stay_owned_between_tunnels_and_release_on_exit() {
+        let requested = "127.0.0.1:0".parse().unwrap();
+        let socks = TcpListener::bind(requested).await.unwrap();
+        let http = TcpListener::bind(requested).await.unwrap();
+        let socks_at = socks.local_addr().unwrap();
+        let http_at = http.local_addr().unwrap();
+        scope(socks, requested, Some(http), Some(requested), async {
+            for _ in 0..2 {
+                let socks = crate::socks::bind_listener("socks5", requested)
+                    .await
+                    .unwrap();
+                let http = crate::socks::bind_listener("http proxy", requested)
+                    .await
+                    .unwrap();
+                assert_eq!(socks.local_addr().unwrap(), socks_at);
+                assert_eq!(http.local_addr().unwrap(), http_at);
+                drop((socks, http));
+                assert!(TcpListener::bind(socks_at).await.is_err());
+                assert!(TcpListener::bind(http_at).await.is_err());
+            }
+            // A separate task must not accidentally share these ports.
+            assert!(tokio::spawn(
+                async move { crate::socks::bind_listener("socks5", socks_at).await }
+            )
+            .await
+            .unwrap()
+            .is_err());
+        })
+        .await
+        .unwrap();
+        assert!(TcpListener::bind(socks_at).await.is_ok());
+        assert!(TcpListener::bind(http_at).await.is_ok());
+    }
+}
