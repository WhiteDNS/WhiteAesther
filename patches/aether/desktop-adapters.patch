+/// Reject a configured proxy before any provisioning or network operation.
+pub fn check_setting() -> Result<()> {
+    let value = std::env::var("AETHER_UPSTREAM").unwrap_or_default();
+    if value.trim().is_empty() {
+        return Ok(());
+    }
+    Upstream::parse(&value)
+        .map(drop)
+        .map_err(|error| AetherError::Other(format!("--upstream cannot be used: {error}")))
