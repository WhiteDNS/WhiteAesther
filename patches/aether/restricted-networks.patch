+/// Desktop trials are separate processes. An in-process provisioning mutex
+/// cannot keep them from registering twice or overwriting a pending key.
+/// The OS releases this lock even when a losing sidecar is killed.
+pub async fn lock_store(store_path: &str) -> Result<std::fs::File> {
+    let path = std::path::PathBuf::from(format!("{store_path}.lock"));
+    if let Some(parent) = path.parent().filter(|p| !p.as_os_str().is_empty()) {
+        std::fs::create_dir_all(parent)?;
+    }
+    let file = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .open(path)?;
+    loop {
+        match file.try_lock() {
+            Ok(()) => return Ok(file),
+            Err(std::fs::TryLockError::WouldBlock) => {
+                tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+            }
+            Err(std::fs::TryLockError::Error(error)) => return Err(error.into()),
+        }
+    }
+}
