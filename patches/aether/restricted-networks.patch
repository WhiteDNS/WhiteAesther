@@ -0,0 +1,194 @@
+//! Construct and poll engine futures on a stack owned by the engine. Tokio's
+//! worker stack setting does not cover the thread calling Runtime::block_on.
+use std::future::Future;
+
+use crate::error::{AetherError, Result};
+
+pub const STACK_BYTES: usize = 8 * 1024 * 1024;
+
+fn runtime() -> Result<tokio::runtime::Runtime> {
+    tokio::runtime::Builder::new_multi_thread()
+        .thread_stack_size(STACK_BYTES)
+        .enable_all()
+        .build()
+        .map_err(AetherError::from)
+}
+
+/// `make` runs inside the new thread, including construction of its future.
+pub fn run<T, F, Fut>(make: F) -> Result<T>
+where
+    T: Send + 'static,
+    F: FnOnce() -> Fut + Send + 'static,
+    Fut: Future<Output = Result<T>>,
+{
+    std::thread::Builder::new()
+        .name("aether-engine".into())
+        .stack_size(STACK_BYTES)
+        .spawn(move || runtime()?.block_on(Box::pin(make())))?
+        .join()
+        .map_err(|_| AetherError::Other("engine thread panicked".into()))?
+}
+
+/// Dropping the awaiting caller closes the channel, drops the root future and
+/// releases its sockets and runtime. No detached preparation survives cancel.
+pub async fn dispatch<T, F, Fut>(make: F) -> Result<T>
+where
+    T: Send + 'static,
+    F: FnOnce() -> Fut + Send + 'static,
+    Fut: Future<Output = Result<T>>,
+{
+    let upstream = crate::upstream::scoped();
+    let (mut reply, answer) = tokio::sync::oneshot::channel();
+    std::thread::Builder::new()
+        .name("aether-prepare".into())
+        .stack_size(STACK_BYTES)
+        .spawn(move || {
+            let result = match runtime() {
+                Ok(runtime) => runtime.block_on(Box::pin(async {
+                    let operation = async {
+                        match upstream {
+                            Some(proxy) => {
+                                crate::upstream::through(
+                                    proxy,
+                                    async move { Box::pin(make()).await },
+                                )
+                                .await
+                            }
+                            None => Box::pin(make()).await,
+                        }
+                    };
+                    tokio::select! {
+                        biased;
+                        _ = reply.closed() => return None,
+                        result = Box::pin(operation) => Some(result),
+                    }
+                })),
+                Err(error) => Some(Err(error)),
+            };
+            if let Some(result) = result {
+                let _ = reply.send(result);
+            }
+        })?;
+    answer
+        .await
+        .map_err(|_| AetherError::Other("engine preparation thread panicked".into()))?
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    };
+
+    #[tokio::test]
+    async fn scoped_upstreams_survive_dispatch_and_remain_isolated() {
+        let _settings = crate::upstream::hold_setting().await;
+        let first = crate::upstream::Upstream::parse("socks5h://127.0.0.1:18001").unwrap();
+        let second = crate::upstream::Upstream::parse("socks5h://127.0.0.1:18002").unwrap();
+        let (a, b) = tokio::join!(
+            crate::upstream::through(
+                first.clone(),
+                dispatch(|| {
+                    let constructed_with = crate::upstream::configured();
+                    async move {
+                        assert_eq!(constructed_with, crate::upstream::configured());
+                        Ok(constructed_with)
+                    }
+                })
+            ),
+            crate::upstream::through(
+                second.clone(),
+                dispatch(|| async { Ok(crate::upstream::configured()) })
+            ),
+        );
+        assert_eq!(a.unwrap(), Some(first));
+        assert_eq!(b.unwrap(), Some(second));
+        assert!(crate::upstream::configured().is_none());
+    }
+
+    #[inline(never)]
+    fn stack_heavy() -> u64 {
+        let bytes = std::hint::black_box([7u8; 512 * 1024]);
+        bytes.iter().map(|byte| *byte as u64).sum()
+    }
+
+    #[test]
+    fn prepare_and_root_polling_are_safe_from_a_small_caller_stack() {
+        std::thread::Builder::new()
+            .stack_size(256 * 1024)
+            .spawn(|| {
+                assert_eq!(run(|| async { Ok(stack_heavy()) }).unwrap(), 7 * 512 * 1024);
+                let rt = tokio::runtime::Builder::new_current_thread()
+                    .enable_all()
+                    .build()
+                    .unwrap();
+                rt.block_on(async {
+                    let _settings = crate::upstream::hold_setting().await;
+                    let previous = std::env::var("AETHER_ENROLL_ADDRESS").ok();
+                    std::env::set_var("AETHER_ENROLL_ADDRESS", "https://invalid.example");
+                    let config = crate::EmbeddedConfig {
+                        config_path: "unused-small-stack-test.toml".into(),
+                        listen: "127.0.0.1:0".parse().unwrap(),
+                        peer: None,
+                        peer_fallback: false,
+                        scan_mode: "turbo".into(),
+                        ip_scan: "4".into(),
+                        protocol: "masque".into(),
+                        access: crate::socks::Access::default(),
+                    };
+                    let prepare = crate::prepare_embedded(&config);
+                    assert!(std::mem::size_of_val(&prepare) < 16 * 1024);
+                    // Real preparation stops at offline option validation, before
+                    // any public registration or endpoint probe is possible.
+                    assert!(matches!(Box::pin(prepare).await, Err(AetherError::Api(_))));
+                    match previous {
+                        Some(value) => std::env::set_var("AETHER_ENROLL_ADDRESS", value),
+                        None => std::env::remove_var("AETHER_ENROLL_ADDRESS"),
+                    }
+                    assert_eq!(
+                        dispatch(|| async {
+                            let root = stack_heavy();
+                            let worker = tokio::spawn(async { stack_heavy() }).await.unwrap();
+                            Ok(root + worker)
+                        })
+                        .await
+                        .unwrap(),
+                        14 * 512 * 1024
+                    );
+                });
+            })
+            .unwrap()
+            .join()
+            .unwrap();
+    }
+
+    #[tokio::test]
+    async fn cancellation_drops_the_operation_and_its_resources() {
+        struct Resource(Arc<AtomicBool>);
+        impl Drop for Resource {
+            fn drop(&mut self) {
+                self.0.store(true, Ordering::SeqCst);
+            }
+        }
+        let dropped = Arc::new(AtomicBool::new(false));
+        let flag = dropped.clone();
+        let (started, ready) = tokio::sync::oneshot::channel();
+        let operation = tokio::spawn(dispatch(move || async move {
+            let _resource = Resource(flag);
+            let _ = started.send(());
+            std::future::pending::<Result<()>>().await
+        }));
+        ready.await.unwrap();
+        operation.abort();
+        let _ = operation.await;
+        tokio::time::timeout(std::time::Duration::from_secs(3), async {
+            while !dropped.load(Ordering::SeqCst) {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+    }
+}
