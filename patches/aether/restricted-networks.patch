diff --git a/aether/src/api_routes.rs b/aether/src/api_routes.rs
new file mode 100644
--- /dev/null
+++ b/aether/src/api_routes.rs
@@ -0,0 +1,323 @@
+//! Aether 2.4 API names with authenticated, mutation-safe route selection.
+use std::time::Duration;
+
+use futures::{stream::FuturesUnordered, FutureExt, StreamExt};
+
+use crate::error::{AetherError, Result};
+use crate::{apifront, fragment::FragmentConfig, https, tls};
+
+const PRIMARY: &str = "api.devices.cloudflare.com";
+const LEGACY: &str = "api.cloudflareclient.com";
+static ANSWERED: std::sync::Mutex<Option<String>> = std::sync::Mutex::new(None);
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Route {
+    host: String,
+    sni: String,
+    address: Option<(String, u16)>,
+}
+
+fn setting(key: &str) -> Option<String> {
+    std::env::var(key)
+        .ok()
+        .map(|v| v.trim().to_string())
+        .filter(|v| !v.is_empty())
+}
+
+fn name(key: &str, flag: &str) -> Result<Option<String>> {
+    let Some(value) = setting(key) else {
+        return Ok(None);
+    };
+    let value = value.trim_end_matches('.');
+    if !crate::dns::valid_domain(value) || value.parse::<std::net::IpAddr>().is_ok() {
+        return Err(AetherError::Api(format!("{flag}: invalid domain name")));
+    }
+    Ok(Some(value.into()))
+}
+
+fn routes() -> Result<Vec<Route>> {
+    let host = name("AETHER_API_HOST", "--api-host")?;
+    let sni = name("AETHER_API_SNI", "--api-sni")?;
+    let address = setting("AETHER_API_ADDRESS").or_else(|| setting("AETHER_ENROLL_ADDRESS"));
+    let address = address
+        .map(|value| {
+            crate::dns::host_and_port(&value, 443)
+                .ok_or_else(|| AetherError::Api("--api-address: invalid address or port".into()))
+        })
+        .transpose()?;
+    let mut hosts = if host.is_some() || sni.is_some() {
+        vec![host.unwrap_or_else(|| PRIMARY.into())]
+    } else if setting("AETHER_API_ADDRESS").is_none() && setting("AETHER_ENROLL_ADDRESS").is_some()
+    {
+        // Preserve the old override's API name. New --api-address uses both names.
+        vec![LEGACY.into()]
+    } else {
+        let answered = ANSWERED
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if answered.as_deref() == Some(LEGACY) {
+            vec![LEGACY.into(), PRIMARY.into()]
+        } else {
+            vec![PRIMARY.into(), LEGACY.into()]
+        }
+    };
+    Ok(hosts
+        .drain(..)
+        .map(|host| Route {
+            sni: sni.clone().unwrap_or_else(|| host.clone()),
+            host,
+            address: address.clone(),
+        })
+        .collect())
+}
+
+pub(crate) fn check() -> Result<()> {
+    routes().map(drop)
+}
+
+pub(crate) fn forget() {
+    *ANSWERED
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner) = None;
+}
+
+/// A gateway error page is not an API refusal of the saved identity.
+pub(crate) fn is_api_envelope(body: &[u8]) -> bool {
+    serde_json::from_slice::<serde_json::Value>(body)
+        .ok()
+        .is_some_and(|value| {
+            value.get("errors").is_some_and(|v| v.is_array()) || value.get("result").is_some()
+        })
+}
+
+pub(crate) async fn send(
+    request: &https::Request<'_>,
+    fingerprint: &tls::Fingerprint,
+    ech: Option<Vec<u8>>,
+    adaptive: bool,
+    timeout: Duration,
+) -> Result<(https::Response, Option<Vec<u8>>)> {
+    let routes = routes()?;
+    send_by(&routes, request, fingerprint, ech, adaptive, timeout).await
+}
+
+async fn send_by(
+    routes: &[Route],
+    request: &https::Request<'_>,
+    fingerprint: &tls::Fingerprint,
+    ech: Option<Vec<u8>>,
+    adaptive: bool,
+    timeout: Duration,
+) -> Result<(https::Response, Option<Vec<u8>>)> {
+    tokio::time::timeout(timeout, async {
+        let mut remaining: Vec<_> = routes.iter().collect();
+        loop {
+            let mut pending = FuturesUnordered::new();
+            for (index, &route) in remaining.iter().enumerate() {
+                let ech = ech.clone();
+                pending.push(
+                    async move {
+                        if index > 0 {
+                            tokio::time::sleep(Duration::from_millis(200)).await;
+                        }
+                        let routed = https::Request {
+                            host: &route.host,
+                            sni: Some(&route.sni),
+                            address: route
+                                .address
+                                .as_ref()
+                                .map(|(host, port)| (host.as_str(), *port)),
+                            ..*request
+                        };
+                        if adaptive {
+                            let session = apifront::open_adaptive(&routed, fingerprint).await?;
+                            Ok((session.tls, session.ech, route))
+                        } else {
+                            let mut ech = ech;
+                            let tls = https::open(
+                                &routed,
+                                fingerprint,
+                                ech.as_mut(),
+                                FragmentConfig::from_env(),
+                                None,
+                            )
+                            .await?;
+                            Ok((tls, ech, route))
+                        }
+                    }
+                    .boxed(),
+                );
+            }
+            let mut failure = AetherError::Api("every API name failed TLS authentication".into());
+            let winner = loop {
+                match pending.next().await {
+                    Some(Ok(winner)) => break winner,
+                    Some(Err(error)) => failure = error,
+                    None => return Err(failure),
+                }
+            };
+            // Cancel every loser before the first HTTP byte is sent. An ambiguous
+            // exchange is returned to the caller, never retried on another route.
+            drop(pending);
+            let (tls, ech, route) = winner;
+            let routed = https::Request {
+                host: &route.host,
+                sni: Some(&route.sni),
+                ..*request
+            };
+            let response = https::send_on_session(tls, &routed).await?;
+            // An explicit gateway refusal is safe to put to the other API name.
+            // Successes, timeouts, 5xx and malformed successes never replay POST.
+            if matches!(response.status, 403 | 404)
+                && !is_api_envelope(&response.body)
+                && remaining.len() > 1
+            {
+                remaining.retain(|candidate| *candidate != route);
+                continue;
+            }
+            if (200..300).contains(&response.status) || is_api_envelope(&response.body) {
+                *ANSWERED
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner) = Some(route.host.clone());
+            }
+            return Ok((response, ech));
+        }
+    })
+    .await
+    .map_err(|_| AetherError::Api("API bootstrap/exchange timed out".into()))?
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn api_names_fall_back_only_after_an_explicit_gateway_refusal() {
+        let _proxy = crate::upstream::hold_setting().await;
+        let _options = tls::hold_options().await;
+        for (status, body, disconnect, expected_requests) in [
+            (404, "<html>Not Found</html>", false, 2),
+            (200, "malformed success", false, 1),
+            (503, "unavailable", false, 1),
+            (200, "", true, 1),
+        ] {
+            let (address, listener, acceptor) = https::test_server(b"\x02h2").await;
+            let seen = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
+            let received = seen.clone();
+            let server = tokio::spawn(async move {
+                let mut clients = tokio::task::JoinSet::new();
+                loop {
+                    let (tcp, _) = listener.accept().await.unwrap();
+                    let acceptor = acceptor.clone();
+                    let received = received.clone();
+                    clients.spawn(async move {
+                        let Ok(tls) = tokio_boring::accept(&acceptor, tcp).await else {
+                            return;
+                        };
+                        let Ok(mut h2) = h2::server::handshake(tls).await else {
+                            return;
+                        };
+                        while let Some(Ok((request, mut reply))) = h2.accept().await {
+                            let host = request.uri().host().unwrap().to_string();
+                            assert_eq!(request.method(), "POST");
+                            received.lock().unwrap().push(host.clone());
+                            if disconnect {
+                                return;
+                            }
+                            let (status, body) = if host == LEGACY {
+                                (200, "{\"id\":\"device\"}")
+                            } else {
+                                (status, body)
+                            };
+                            let mut stream = reply
+                                .send_response(
+                                    http::Response::builder().status(status).body(()).unwrap(),
+                                    false,
+                                )
+                                .unwrap();
+                            stream.send_data(bytes::Bytes::from(body), true).unwrap();
+                        }
+                    });
+                }
+            });
+            let routes = [PRIMARY, LEGACY].map(|host| Route {
+                host: host.into(),
+                sni: host.into(),
+                address: Some((address.ip().to_string(), address.port())),
+            });
+            let request = https::Request {
+                method: "POST",
+                host: PRIMARY,
+                port: 443,
+                address: None,
+                sni: None,
+                path: "/reg",
+                headers: &[],
+                body: Some(b"registration"),
+            };
+            let outcome = send_by(
+                &routes,
+                &request,
+                &tls::Fingerprint::default(),
+                None,
+                false,
+                Duration::from_secs(3),
+            )
+            .await;
+            if disconnect {
+                assert!(outcome.is_err());
+            } else {
+                assert_eq!(
+                    outcome.unwrap().0.status,
+                    if expected_requests == 2 { 200 } else { status }
+                );
+            }
+            assert_eq!(seen.lock().unwrap().len(), expected_requests);
+            server.abort();
+            let _ = server.await;
+        }
+        forget();
+    }
+
+    #[tokio::test]
+    async fn modern_names_and_legacy_overrides_keep_their_contracts() {
+        let _options = tls::hold_options().await;
+        for key in [
+            "AETHER_API_ADDRESS",
+            "AETHER_ENROLL_ADDRESS",
+            "AETHER_API_HOST",
+            "AETHER_API_SNI",
+        ] {
+            std::env::remove_var(key);
+        }
+        forget();
+        let selected = routes().unwrap();
+        assert_eq!(
+            selected.iter().map(|r| r.host.as_str()).collect::<Vec<_>>(),
+            [PRIMARY, LEGACY]
+        );
+        std::env::set_var("AETHER_API_ADDRESS", "203.0.113.10:8443");
+        assert!(routes()
+            .unwrap()
+            .iter()
+            .all(|r| r.address == Some(("203.0.113.10".into(), 8443))));
+        std::env::remove_var("AETHER_API_ADDRESS");
+        std::env::set_var("AETHER_ENROLL_ADDRESS", "203.0.113.11");
+        assert_eq!(routes().unwrap()[0].host, LEGACY);
+        assert_eq!(routes().unwrap().len(), 1);
+        std::env::remove_var("AETHER_ENROLL_ADDRESS");
+        std::env::set_var("AETHER_API_HOST", "api.example.com");
+        assert_eq!(routes().unwrap()[0].sni, "api.example.com");
+        std::env::set_var("AETHER_API_SNI", "https://invalid.example");
+        assert!(check().is_err());
+        std::env::remove_var("AETHER_API_HOST");
+        std::env::remove_var("AETHER_API_SNI");
+        forget();
+    }
+
+    #[test]
+    fn a_gateway_page_does_not_revoke_an_identity() {
+        assert!(!is_api_envelope(b"<html>Not Found</html>"));
+        assert!(is_api_envelope(br#"{"errors":[{"code":1}]}"#));
+    }
+}
diff --git a/aether/src/listeners.rs b/aether/src/listeners.rs
new file mode 100644
--- /dev/null
+++ b/aether/src/listeners.rs
@@ -0,0 +1,89 @@
+//! CLI listener ownership spans provisioning, scanning and every reconnect.
+//! Task-local ownership keeps independent embedded sessions isolated.
+use crate::error::Result;
+use std::{future::Future, net::SocketAddr};
+use tokio::net::TcpListener;
+
+struct Held {
+    sockets: Vec<(&'static str, SocketAddr, std::net::TcpListener)>,
+}
+
+tokio::task_local! { static HELD: Held; }
+
+pub(crate) async fn scope<T>(
+    socks: TcpListener,
+    requested: SocketAddr,
+    http: Option<TcpListener>,
+    http_requested: Option<SocketAddr>,
+    future: impl Future<Output = T>,
+) -> Result<T> {
+    let mut sockets = vec![("socks5", requested, socks.into_std()?)];
+    if let Some(http) = http {
+        sockets.push((
+            "http proxy",
+            http_requested.unwrap_or(http.local_addr()?),
+            http.into_std()?,
+        ));
+    }
+    Ok(HELD.scope(Held { sockets }, future).await)
+}
+
+/// Each tunnel gets a duplicate of the held socket. Closing that duplicate
+/// cannot release the port while the CLI run is still alive.
+pub(crate) fn duplicate(kind: &str, requested: SocketAddr) -> Option<Result<TcpListener>> {
+    HELD.try_with(|held| {
+        held.sockets
+            .iter()
+            .find(|(name, original, socket)| {
+                *name == kind
+                    && (*original == requested || socket.local_addr().ok() == Some(requested))
+            })
+            .map(|(_, _, socket)| {
+                socket
+                    .try_clone()
+                    .and_then(TcpListener::from_std)
+                    .map_err(Into::into)
+            })
+    })
+    .ok()
+    .flatten()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    async fn socks_and_http_ports_stay_owned_between_tunnels_and_release_on_exit() {
+        let requested = "127.0.0.1:0".parse().unwrap();
+        let socks = TcpListener::bind(requested).await.unwrap();
+        let http = TcpListener::bind(requested).await.unwrap();
+        let socks_at = socks.local_addr().unwrap();
+        let http_at = http.local_addr().unwrap();
+        scope(socks, requested, Some(http), Some(requested), async {
+            for _ in 0..2 {
+                let socks = crate::socks::bind_listener("socks5", requested)
+                    .await
+                    .unwrap();
+                let http = crate::socks::bind_listener("http proxy", requested)
+                    .await
+                    .unwrap();
+                assert_eq!(socks.local_addr().unwrap(), socks_at);
+                assert_eq!(http.local_addr().unwrap(), http_at);
+                drop((socks, http));
+                assert!(TcpListener::bind(socks_at).await.is_err());
+                assert!(TcpListener::bind(http_at).await.is_err());
+            }
+            // A separate task must not accidentally share these ports.
+            assert!(tokio::spawn(
+                async move { crate::socks::bind_listener("socks5", socks_at).await }
+            )
+            .await
+            .unwrap()
+            .is_err());
+        })
+        .await
+        .unwrap();
+        assert!(TcpListener::bind(socks_at).await.is_ok());
+        assert!(TcpListener::bind(http_at).await.is_ok());
+    }
+}
